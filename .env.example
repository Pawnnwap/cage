# Vultr Serverless Inference (OpenAI-compatible)
LLM_MODE=vultr
VULTR_BASE_URL=https://api.vultrinference.com/v1
VULTR_API_KEY=replace-me
VULTR_MODEL=qwen3.8-27b

# Shared secret between the app and sandboxd (set a long random value)
SANDBOXD_TOKEN=replace-with-a-long-random-token

# Public address served by Caddy. A hostname gets automatic HTTPS; without one,
# plain HTTP on the VM IP. No domain? <dashed-ip>.sslip.io resolves to the IP.
# SITE_ADDRESS=203-0-113-10.sslip.io, http://203.0.113.10

# Agent and budget limits
MAX_STEPS=24
TASK_TIMEOUT_S=600
MAX_TASK_TOKENS=200000
MAX_DAILY_TOKENS=2000000
MAX_TASKS_PER_DAY=100

# Public demo safeguards
DEMO_ENABLED=true
MAX_CONCURRENT_TASKS=2
MAX_CONCURRENT_PROBES=1
MAX_PROBE_REPORTS=200
RATE_LIMIT_PER_MINUTE=6
TRUST_PROXY=true
PROBE_TIMEOUT_S=10

# Sandbox limits
WORKSPACE_LIMIT_MB=64
MAX_SANDBOXES=4
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
# Build the sandbox image before compose up:
# docker build -t cage-sandbox:latest sandbox_image

# Evidence signing key (generated automatically if missing)
EVIDENCE_KEY_PATH=/data/evidence_key.pem
